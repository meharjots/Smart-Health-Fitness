      "item": [
        {
          "name": "Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Returns access_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('access_token');",
                  "  pm.collectionVariables.set('user_token', json.data.access_token);",
                  "});",
                  "pm.test('Status field is success', () => pm.expect(pm.response.json().status).to.equal('success'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"securepass\",\n  \"full_name\": \"Test User\",\n  \"age\": 25,\n  \"gender\": \"male\",\n  \"height_cm\": 175,\n  \"weight_kg\": 75,\n  \"membership_type\": \"free\"\n}"
            },
            "url": "{{base_url}}/register"
          }
        },
        {
          "name": "Register - Missing Fields (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Returns error status', () => pm.expect(pm.response.json().status).to.equal('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
