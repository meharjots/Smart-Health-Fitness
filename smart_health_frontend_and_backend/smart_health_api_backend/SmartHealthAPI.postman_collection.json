            "url": { "raw": "{{base_url}}/analytics/admin/top-active-users?limit=5", "query": [{"key":"limit","value":"5"}] }
          }
        },
        {
          "name": "Top Active Users - Unauthorised (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": "{{base_url}}/analytics/admin/top-active-users"
          }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "Get All Users (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginated response', () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d).to.have.property('users');",
                  "  pm.expect(d).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/users?page=1&per_page=10", "query": [{"key":"page","value":"1"},{"key":"per_page","value":"10"}] }
          }
        },
        {
          "name": "Get All Users - Forbidden (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
            "url": "{{base_url}}/users"
          }
        }
      ]
    }
  ]
